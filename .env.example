# Copy to .env and fill in. Never commit .env.
#
# Local dev only — the deployed VPS doesn't use this file directly.
# GitHub Secrets/Variables are the source of truth for production;
# .github/workflows/deploy.yml writes the real .env on the VPS from those
# on every deploy. See DEPLOYMENT.md step 7.
#
# Provider connections (OpenRouter, Anthropic, etc.) are managed at runtime
# through the Models & Providers GUI screen and stored encrypted in the
# database — they do NOT belong in this file. See docs/PRD.md §7.5 / F12.
# The keys below are infrastructure-level, needed before the app can boot.

# --- Postgres ---
POSTGRES_USER=applicient
POSTGRES_PASSWORD=applicient
POSTGRES_DB=applicient
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://applicient:applicient@localhost:5433/applicient

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Object storage (MinIO locally, S3-compatible in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=applicient
S3_SECRET_KEY=applicient-dev-only
S3_BUCKET=applicient
S3_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Published application ports ---
API_PORT=8000
WEB_PORT=3000

# Where the browser lands after the Gmail OAuth flow finishes
# (routers/gmail.py's callback redirect target).
FRONTEND_URL=http://localhost:3000

# v2 Phase 1 — the API's own public base URL, used to build the
# email-verification link (auth.py's verify_email sends a link to
# itself, not to the frontend). e.g. https://api.applicient.my.id in prod.
API_BASE_URL=http://localhost:8000

# Comma-separated list of extra origins the API accepts browser requests
# from, on top of the localhost dev defaults main.py always allows — e.g.
# https://applicient.my.id,https://www.applicient.my.id
# Required in production: without it, the deployed frontend's requests
# get CORS-rejected. Leave empty for local dev.
CORS_ORIGINS=

# --- App secrets ---
# Required — the api container fails to start without this. Used to
# encrypt ProviderConnection.api_key, Credential values, and Gmail
# refresh tokens at rest (Fernet — needs this exact format, not a
# generic random string). No default fallback (SaaS pivot: a shared,
# repo-committed key would decrypt every tenant's secrets). Generate
# your own:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Dev-only login for the seeded demo@applicient.local account (seed.py) —
# never meant for anything deployed.
DEMO_USER_PASSWORD=applicient-dev

# SaaS pivot — the account matching this email (case-insensitive) becomes
# the deployment's admin on signup, or is promoted by the migration if it
# already exists. Only the admin sees/configures LLM providers, model
# profiles, and cost tracking. No self-service path to admin exists.
ADMIN_EMAIL=

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=applicient

# --- Gmail ingestion (M5, not needed for earlier milestones) ---
# From a Google Cloud OAuth 2.0 Client ID (type: Web application).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Must exactly match a redirect URI registered on that OAuth client —
# e.g. http://localhost:8000/gmail/callback for local dev.
GMAIL_REDIRECT_URI=
# v2 Phase 1 — "Continue with Google" login, a SEPARATE registered
# redirect URI on the same OAuth client above (not a new client) —
# e.g. http://localhost:8000/auth/google/callback for local dev. Add
# both this and GMAIL_REDIRECT_URI to the same Google Cloud OAuth
# client's authorized redirect URIs list.
GOOGLE_LOGIN_REDIRECT_URI=
# Optional — a Pub/Sub topic (real GCP infra, provisioned out-of-band)
# that grants publish rights to gmail-api-push@system.gserviceaccount.com.
# Without it, Gmail connect still works but only via polling, not push.
GMAIL_PUBSUB_TOPIC=
# Must exactly match the push subscription's own endpoint URL — Google
# stamps this as the `aud` claim on the OIDC token it attaches to each
# push request, and routers/webhooks.py checks against it.
GMAIL_PUSH_ENDPOINT_URL=

# --- Browser worker ---
# Cap on concurrent Chromium sessions (browser_worker/sessions.py).
# Default 20 assumes a big box — on a modest VPS (e.g. 4GB RAM shared
# with postgres/redis/minio/api/web), 2 is safer; each session is a
# real Chromium process. See DEPLOYMENT.md.
BROWSER_WORKER_MAX_SESSIONS=20

# --- Production image source (GitHub Actions → Docker Hub, see
# .github/workflows/deploy.yml) ---
# Your Docker Hub username. Used to build the image reference for
# api/web/browser-worker. Not needed for local dev (docker compose build
# ignores it).
DOCKERHUB_USERNAME=
# Which tag `docker compose pull` fetches. Leave as latest normally; CI
# also pushes a per-commit tag (the short git SHA) if you ever need to
# pin/roll back to a specific build — set this to that SHA temporarily,
# `docker compose pull api web browser-worker && docker compose up -d`,
# then set it back to latest.
IMAGE_TAG=latest

# --- Production reverse proxy (Caddy, profile "prod" only) ---
# Let's Encrypt sends renewal/expiry notices here. Not used locally.
CADDY_EMAIL=

# --- Transactional email (v2 Phase 0, Resend) ---
# Dashboard → API Keys. Free tier is plenty for verification emails and
# scheduled-run summaries.
RESEND_API_KEY=
# Must be on a domain verified in Resend's dashboard, or sends fail
# outright — leave unset to use Resend's shared sandbox sender
# (onboarding@resend.dev), fine for local dev/testing.
EMAIL_FROM=

# --- Billing (SaaS pivot, Dodo Payments) ---
# Dashboard → Developer → API Keys. Use a test-mode key
# until you're ready to go live.
DODO_PAYMENTS_API_KEY=
# "test_mode" or "live_mode" — must match which kind of API key above.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Dashboard → Developer → Webhooks → your endpoint → signing secret.
# Standard Webhooks spec (webhook-id/webhook-signature/webhook-timestamp
# headers) — routers/webhooks.py's /webhooks/dodo verifies every
# request against this before trusting it.
DODO_PAYMENTS_WEBHOOK_KEY=
# Frontend build-time flag (web/Dockerfile ARG, like NEXT_PUBLIC_API_URL) —
# "live" only once you're actually taking real payments; anything else
# stays in the checkout overlay's test mode. Deliberately NOT the same
# var as DODO_PAYMENTS_ENVIRONMENT above: that one's read server-side at
# runtime, this one gets baked into the client bundle at build time.
NEXT_PUBLIC_DODO_PAYMENTS_MODE=test
