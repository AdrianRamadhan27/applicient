# Copy to .env and fill in. Never commit .env.
#
# Provider connections (OpenRouter, Anthropic, etc.) are managed at runtime
# through the Models & Providers GUI screen and stored encrypted in the
# database — they do NOT belong in this file. See docs/PRD.md §7.5 / F12.
# The keys below are infrastructure-level, needed before the app can boot.

# --- Postgres ---
POSTGRES_USER=applicient
POSTGRES_PASSWORD=applicient
POSTGRES_DB=applicient
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://applicient:applicient@localhost:5433/applicient

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Object storage (MinIO locally, S3-compatible in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=applicient
S3_SECRET_KEY=applicient-dev-only
S3_BUCKET=applicient
S3_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Published application ports ---
API_PORT=8000
WEB_PORT=3000

# Where the browser lands after the Gmail OAuth flow finishes
# (routers/gmail.py's callback redirect target).
FRONTEND_URL=http://localhost:3000

# --- App secrets ---
# Used to encrypt ProviderConnection.api_key at rest (Fernet — needs
# this exact format, not a generic random string). The Compose file has a
# development-only fallback, but set your own key for anything beyond local
# development. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Dev-only login for the seeded demo@applicient.local account (seed.py) —
# never meant for anything deployed.
DEMO_USER_PASSWORD=applicient-dev

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=applicient

# --- Gmail ingestion (M5, not needed for earlier milestones) ---
# From a Google Cloud OAuth 2.0 Client ID (type: Web application).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Must exactly match a redirect URI registered on that OAuth client —
# e.g. http://localhost:8000/gmail/callback for local dev.
GMAIL_REDIRECT_URI=
# Optional — a Pub/Sub topic (real GCP infra, provisioned out-of-band)
# that grants publish rights to gmail-api-push@system.gserviceaccount.com.
# Without it, Gmail connect still works but only via polling, not push.
GMAIL_PUBSUB_TOPIC=
# Must exactly match the push subscription's own endpoint URL — Google
# stamps this as the `aud` claim on the OIDC token it attaches to each
# push request, and routers/webhooks.py checks against it.
GMAIL_PUSH_ENDPOINT_URL=
