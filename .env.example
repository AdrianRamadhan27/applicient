# Copy to .env and fill in. Never commit .env.
#
# Provider connections (OpenRouter, Anthropic, etc.) are managed at runtime
# through the Models & Providers GUI screen and stored encrypted in the
# database — they do NOT belong in this file. See docs/PRD.md §7.5 / F12.
# The keys below are infrastructure-level, needed before the app can boot.

# --- Postgres ---
POSTGRES_USER=applicient
POSTGRES_PASSWORD=applicient
POSTGRES_DB=applicient
DATABASE_URL=postgresql://applicient:applicient@localhost:5432/applicient

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, S3-compatible in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=applicient
S3_SECRET_KEY=applicient-dev-only
S3_BUCKET=applicient

# --- App secrets ---
# Used to encrypt ProviderConnection.api_key at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=applicient

# --- Gmail ingestion (M4, not needed for early milestones) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
